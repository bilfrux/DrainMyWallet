{
  "name": "drainmywallet",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "npm start",
    "prestart": "node scripts/dev-guard.mjs",
    "start": "npm start --workspace app",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky"
  },
  "workspaces": [
    "app",
    "app-lib",
    "app-lib/clients/*"
  ],
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3"
  },
  "prettier": "@theahaco/ts-config/prettier",
  "lint-staged": {
    "app/**/*.{js,mjs,ts,tsx}": "eslint --fix --no-warn-ignored",
    "*": "prettier --write --ignore-unknown"
  }
}
